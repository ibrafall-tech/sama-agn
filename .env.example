# Base PostgreSQL. En local : `npm run db:up` (Docker). Sur Vercel : ajoutez Neon
# depuis l'onglet Storage, la variable DATABASE_URL est créée automatiquement.
DATABASE_URL=postgres://midi:midi@localhost:5433/midi

# Code donné à tous les collègues pour entrer dans l'app.
OFFICE_CODE=midi2026

# Code réservé à la personne qui saisit le menu du jour.
ADMIN_CODE=chef2026

# Secret de signature des sessions : au moins 32 caractères aléatoires.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=remplacez-moi-par-une-longue-valeur-aleatoire-de-32-caracteres
