{
  "name": "sama-agn",
  "version": "1.0.0",
  "private": true,
  "description": "PWA de commande des repas du midi pour le bureau : chacun choisit dans le menu du jour, la personne qui va au restaurant récupère la feuille.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "next": "^15.5.4",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
